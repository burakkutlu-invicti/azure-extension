{
  "openapi": "3.0.3",
  "info": {
    "title": "Client Assertion Demo API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://invicti-demo-api-a052d7.azurewebsites.net"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health check",
        "security": [],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/data": {
      "get": {
        "summary": "Protected data",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "401": {
            "description": "Missing or invalid token"
          },
          "403": {
            "description": "Missing role"
          }
        }
      }
    }
  }
}